#!/usr/bin/env bash
#
# pre-commit hook — 提交前检查测试
#
# 安装:
#   cp tools/pre-commit.sh .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#

set -e

echo "🔍 Pre-commit 检查..."

# 项目根目录：用 git rev-parse 解析（兼容 symlink 与 cp 两种安装方式）。
# 旧实现 readlink+../../.. 在 cp 安装到 .git/hooks/ 时会把根解析到仓库父目录，
# 导致 memory 索引跳过、pipeline 重建路径错误、误阻断提交。
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$PROJECT_ROOT" ]]; then
  echo "⚠️ 无法解析项目根目录，跳过 pre-commit 检查" >&2
  exit 0
fi

# ==================== 检查 0: Memory 索引更新 ====================

# 检查是否有 memory 文件变更
MEMORY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^\.harness/knowledge/memory/.*\.md$' || true)

if [[ -n "$MEMORY_FILES" ]]; then
    echo ""
    echo "[0/5] 更新 Memory 索引..."

    if [[ -x "$PROJECT_ROOT/.harness/scripts/memory-index-build.sh" ]]; then
        if bash "$PROJECT_ROOT/.harness/scripts/memory-index-build.sh" > /dev/null 2>&1; then
            # 自动 stage 索引文件
            git add "$PROJECT_ROOT/.harness/knowledge/memory/.memory-index.json" 2>/dev/null || true
            echo "  ✅ Memory 索引已更新并自动添加到提交"
        else
            echo "  ⚠️  Memory 索引更新失败（继续提交）"
        fi
    else
        echo "  ⚠️  Memory 索引构建脚本未找到（跳过）"
    fi
fi

# ==================== 检查 0.5: Pipeline 产物同步 ====================
# 防止 harness-pipeline.js 与源文件漂移（历史教训：产物被手工修改后与
# agents/prompts/*.js + harness-pipeline-core.js 脱节，导致 Debug/Review
# 判定字段不一致）。源文件变更时自动重建并加入提交。

PIPELINE_SRC_FILES=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^\.harness/(agents/prompts/.*\.js|workflows/harness-pipeline-core\.js|scripts/build-pipeline\.sh)$' || true)

if [[ -n "$PIPELINE_SRC_FILES" ]]; then
    echo ""
    echo "[0.5] 重建 harness-pipeline.js（源文件已变更）..."
    if bash "$PROJECT_ROOT/.harness/scripts/build-pipeline.sh" > /dev/null 2>&1; then
        git add "$PROJECT_ROOT/.harness/workflows/harness-pipeline.js" 2>/dev/null || true
        echo "  ✅ harness-pipeline.js 已重建并自动添加到提交"
    else
        echo ""
        echo "❌ harness-pipeline.js 重建失败！"
        echo "  请先修复 .harness/agents/prompts/ 下的源文件，再重新提交。"
        echo "  不要直接手工修改 .harness/workflows/harness-pipeline.js。"
        exit 1
    fi
fi

# ==================== 检查 0.6: Harness 自检（改动 workflows/skills 时） ====================

HARNESS_SRC_FILES=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^\.harness/(workflows|skills|scripts|agents)/' || true)

if [[ -n "$HARNESS_SRC_FILES" ]]; then
    echo ""
    echo "[0.6] Harness 自检（流程引用/命名口径/文档同步/配置漂移/调用链）..."
    if bash "$PROJECT_ROOT/.harness/scripts/harness-self-check.sh" > /tmp/harness-self-check.out 2>&1; then
        echo "  ✅ Harness 自检通过"
    elif [ $? -eq 2 ]; then
        echo "  ⚠️  Harness 自检有 WARN（不阻断，建议查看）："
        cat /tmp/harness-self-check.out | grep WARN
    else
        echo "  ❌ Harness 自检 FAIL（改动 harness 时破坏了自身一致性）："
        cat /tmp/harness-self-check.out | grep -E "FAIL|摘要"
        echo "  请修复后重新提交，或用 bash .harness/scripts/harness-self-check.sh 查看详情。"
        exit 1
    fi
fi

# ==================== 检查 0.7: 密钥检测（gitleaks，所有提交都跑） ====================

echo ""
echo "[0.7] 密钥检测（gitleaks protect --staged）..."

if command -v gitleaks &> /dev/null; then
    if ! gitleaks protect --staged --no-banner 2>&1; then
        echo ""
        echo "⚠️  检测到疑似密钥（AK/Token/私钥等），禁止提交！"
        echo "💡 提示: gitleaks protect --staged 查看详情；密钥改走 .env"
        exit 1
    fi
    echo "  ✅ 密钥检测通过"
else
    echo "  ⚠️  gitleaks 未安装，跳过密钥检测"
    echo "  安装: go install github.com/zricethezav/gitleaks/v8@latest"
fi

# ==================== 检查 1: Go 文件变更检测 ====================

# 获取所有待提交的 Go 文件
GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' | grep -v '_test\.go$' || true)

if [[ -z "$GO_FILES" ]] && [[ -z "$MEMORY_FILES" ]] && [[ -z "$PIPELINE_SRC_FILES" ]] && [[ -z "$HARNESS_SRC_FILES" ]]; then
    echo "✅ 没有 Go 文件或 Memory 文件变更"
    exit 0
fi

if [[ -z "$GO_FILES" ]] && [[ -z "$HARNESS_SRC_FILES" ]]; then
    echo "✅ 没有 Go 文件变更（已处理 Memory）"
    exit 0
fi

echo "检查到 Go 文件变更:"
echo "$GO_FILES" | sed 's/^/  - /'
echo ""

# ==================== 检查 1: Logic 文件必须有测试 ====================

echo "[1/4] 检查 Logic 文件是否有对应的测试..."

MISSING_TESTS=()

for file in $GO_FILES; do
    # 只检查 logic 目录下的文件
    if [[ "$file" == *"/logic/"* ]] && [[ "$file" == *"_logic.go" ]]; then
        test_file="${file%_logic.go}_logic_test.go"

        if [[ ! -f "$test_file" ]] && [[ ! $(git diff --cached --name-only | grep "$test_file") ]]; then
            MISSING_TESTS+=("$file")
        fi
    fi
done

if [[ ${#MISSING_TESTS[@]} -gt 0 ]]; then
    echo "❌ 以下 Logic 文件缺少测试:"
    for file in "${MISSING_TESTS[@]}"; do
        echo "  - $file"
        echo "    需要: ${file%_logic.go}_logic_test.go"
    done
    echo ""
    echo "💡 提示:"
    echo "  1. 创建测试文件: vim ${MISSING_TESTS[0]%_logic.go}_logic_test.go"
    echo "  2. 参考测试模板: services/user-service/api/internal/logic/user/user_logic_test.go"
    echo "  3. 或者使用 --no-verify 跳过检查（不推荐）: git commit --no-verify"
    echo ""
    exit 1
fi

echo "  ✅ 所有 Logic 文件都有对应的测试"

# ==================== 检查 2: 运行测试 ====================

echo ""
echo "[2/4] 运行变更文件的测试..."

# 提取所有变更的包路径
RAW_PACKAGES=$(echo "$GO_FILES" | xargs -I {} dirname {} | sort -u | sed 's|^|./|' | tr '\n' ' ')

# 区分位于 go.work workspace 内/外的包：
# .harness/ 下的独立 Go 工具（如 graph-populator）有 go.mod 但不在 go.work，
# 需 GOWORK=off 测试，否则 go test 报 "not one of workspace modules"。
PACKAGES=""
EXT_PACKAGES=""
for pkg in $RAW_PACKAGES; do
    search="$pkg"
    module_dir=""
    while [[ "$search" != "." && "$search" != "/" ]]; do
        if [[ -f "$search/go.mod" ]]; then
            module_dir="$search"
            break
        fi
        search=$(dirname "$search")
    done
    if [[ -n "$module_dir" ]]; then
        if grep -qF "$module_dir" go.work 2>/dev/null; then
            PACKAGES="$PACKAGES $pkg"
        else
            EXT_PACKAGES="$EXT_PACKAGES $pkg"
        fi
    fi
done
PACKAGES=$(echo $PACKAGES | xargs)
EXT_PACKAGES=$(echo $EXT_PACKAGES | xargs)

test_failed=false
if [[ -n "$PACKAGES" ]]; then
    echo "  测试包: $PACKAGES"
    go test $PACKAGES -short 2>&1 || test_failed=true
fi
if [[ -n "$EXT_PACKAGES" ]]; then
    echo "  测试包(go.work 外, GOWORK=off): $EXT_PACKAGES"
    # 逐包 cd 到所属模块目录测试（go -C），因 GOWORK=off 下项目根无 go.mod
    for pkg in $EXT_PACKAGES; do
        search="$pkg"; mdir=""
        while [[ "$search" != "." && "$search" != "/" ]]; do
            if [[ -f "$search/go.mod" ]]; then mdir="$search"; break; fi
            search=$(dirname "$search")
        done
        if [[ -n "$mdir" ]]; then
            rel_pkg="${pkg#${mdir}/}"
            [[ "$rel_pkg" == "$pkg" ]] && rel_pkg="."
            GOWORK=off go -C "$mdir" test "./$rel_pkg" -short 2>&1 || test_failed=true
        fi
    done
fi

if $test_failed; then
    echo ""
    echo "❌ 测试失败"
    echo ""
    echo "💡 提示:"
    echo "  1. 修复测试: go test $PACKAGES $EXT_PACKAGES -v"
    echo "  2. 或者使用 --no-verify 跳过检查（不推荐）"
    echo ""
    exit 1
elif [[ -z "$PACKAGES" && -z "$EXT_PACKAGES" ]]; then
    echo "  ℹ️  没有需要测试的包"
else
    echo "  ✅ 测试通过"
fi

# ==================== 检查 3: 代码格式 ====================

echo ""
echo "[3/4] 检查代码格式..."

UNFORMATTED=$(echo "$GO_FILES" | xargs gofmt -l || true)

if [[ -n "$UNFORMATTED" ]]; then
    echo "❌ 以下文件格式不正确:"
    echo "$UNFORMATTED" | sed 's/^/  - /'
    echo ""
    echo "💡 提示:"
    echo "  1. 自动格式化: gofmt -w $UNFORMATTED"
    echo "  2. 或者: go fmt ./..."
    echo ""
    exit 1
fi

echo "  ✅ 代码格式正确"

# ==================== 检查 4: 静态分析 ====================

echo ""
echo "[4/4] 运行静态分析..."

if command -v golangci-lint &> /dev/null; then
    # go.work 下仓库根目录跑 ./... 会报「directory prefix . does not contain modules listed in go.work」，
    # 改为按本次变更 .go 文件所属模块逐个跑（2026-08-17 修复：原来 grep 模式匹配不到 golangci 输出，装了也永远"通过"）。
    STAGED_GO=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
    if [[ -z "$STAGED_GO" ]]; then
        echo "  ✅ 无 Go 文件变更，跳过静态分析"
    else
        LINT_FAIL=0
        for f in $STAGED_GO; do
            d=$(dirname "$PROJECT_ROOT/$f")
            while [[ "$d" != "/" && ! -f "$d/go.mod" ]]; do d=$(dirname "$d"); done
            [[ -f "$d/go.mod" ]] && echo "$d"
        done | sort -u > /tmp/golangci-mods.$$
        while read -r mod; do
            [[ -z "$mod" ]] && continue
            echo "  → golangci-lint ($(echo "$mod" | sed "s#$PROJECT_ROOT/##"))"
            if ! (cd "$mod" && golangci-lint run ./... --new-from-rev=HEAD~ --timeout=2m); then
                LINT_FAIL=1
            fi
        done < /tmp/golangci-mods.$$
        rm -f /tmp/golangci-mods.$$
        if [[ $LINT_FAIL -eq 1 ]]; then
            echo ""
            echo "⚠️  发现新增静态分析问题（golangci-lint run 查看详情）"
            echo "💡 提示: 用 golangci-lint run ./... 看完整信息；或用 --no-verify 跳过（不推荐）"
            exit 1
        fi
        echo "  ✅ 静态分析通过"
    fi
else
    echo "  ⚠️  golangci-lint 未安装，跳过静态分析"
    echo "  安装: go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest"
fi

# ==================== 完成 ====================

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✅ Pre-commit 检查全部通过"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

exit 0
