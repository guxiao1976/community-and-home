#!/usr/bin/env bash
#
# Git pre-commit hook — 记忆索引自动更新
#
# 功能：
#   - 检测 .harness/knowledge/memory/*.md 文件变更
#   - 自动重建索引文件 .memory-index.json
#   - 将索引文件添加到 commit
#
# 安装：
#   ln -sf ../../.harness/scripts/git-hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#

set -e

# ─── 检查是否有记忆文件变更 ───
MEMORY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "^.harness/knowledge/memory/.*\.md$" || true)

if [ -z "$MEMORY_FILES" ]; then
    # 没有记忆文件变更，跳过
    exit 0
fi

echo "🔄 检测到记忆文件变更，重建索引..."
echo "$MEMORY_FILES" | sed 's/^/   - /'

# ─── 重建索引 ───
bash .harness/scripts/memory-index-build.sh > /dev/null 2>&1

INDEX_FILE=".harness/knowledge/memory/.memory-index.json"

if [ ! -f "$INDEX_FILE" ]; then
    echo "❌ 错误: 索引构建失败"
    exit 1
fi

# ─── 检查索引是否变更 ───
if git diff --exit-code "$INDEX_FILE" > /dev/null 2>&1; then
    echo "✅ 索引无需更新"
else
    echo "✅ 索引已更新，添加到 commit"
    git add "$INDEX_FILE"
fi

exit 0
