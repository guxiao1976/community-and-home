# ============================================================
# 社区平台共享密钥（示例文件 — 提交到 git）
# 复制为 .env 并填入真实密钥值
# ============================================================

# 运行环境: development | staging | production
ENV=development

# --- AES 加密密钥（32 字节 = AES-256）---
# 生成方式：openssl rand -base64 32
AES_KEY=F9PXfr0tO63uqi8EUqyBTrh8Eq6Lr7CfgqshlKODzy4

# --- MySQL 凭证 ---
# 请与 docker-compose.yml 中的 MYSQL_ROOT_PASSWORD 保持一致
MYSQL_USER=root
MYSQL_PASSWORD=root123456

# --- Redis 密码 ---
REDIS_PASSWORD=123456

# --- JWT 密钥 ---
# 生成方式：openssl rand -base64 32
JWT_ACCESS_SECRET=QBViQKNdUpsAdq48ClBoFxRoRwayo7MZFrLr_eu5NL8
JWT_REFRESH_SECRET=-hSf5SGq_7AQaE6GDXhALU53LhK7Er2gQMDTS9RMVL4

# --- RSA 密钥对 ---
# 生成方式：openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#           openssl rsa -pubout -in private.pem -out public.pem
RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...replace with real public key...
-----END PUBLIC KEY-----"

RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...replace with real private key...
-----END RSA PRIVATE KEY-----"

# --- 高德地图 API Key ---
# 申请地址：https://console.amap.com/
AMAP_KEY=your_amap_key_here

# --- MinIO 对象存储凭证 ---
# 请与 docker-compose.yml 中的 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 保持一致
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123

# --- Neo4j 图数据库密码 ---
# 用于 AI Harness 知识图谱存储
# 首次启动时设置，后续不可更改（除非清空 ./data/neo4j-data）
NEO4J_PASSWORD=neo4j123456

# --- AI 模型服务加密密钥（32 字节 = AES-256）---
# 生成方式：openssl rand -base64 32
# ⚠️ ai-model-service 使用 conf.MustLoad（不支持 ${VAR} 展开），需在配置中直接设置真实值
ENCRYPTION_KEY=9v2kvrLGIqimhRFRxNPK6t2eb7BoYTGdADKC2QkEXBA
